---
import ProjectComponent from "../components/ProjectComponent.astro";
---

<div class="projects" id="projects">
    <div class="big-light"></div>
    <div class="projects-container">
        <div class="projects-header">
            <h2 class="projects-title">Proyectos</h2>
            <div class="projects-subline"></div>
        </div>
        
        <ProjectComponent
            title="MedStock"
            description="Sistema integral de gestión de stock de medicamentos para geriátricos. Permite monitorear los niveles de suministro de cada residente en tiempo real, recibir alertas de stock bajo y gestionar recetas de forma eficiente. Desarrollado con un enfoque mobile-first y optimización SEO."
            skills={["Astro", "React", "TypeScript", "Tailwind CSS", "SEO"]}
            url="https://medstock.com.ar/"
        />

        <!-- You can add more projects here in the future -->
        
    </div>
</div>

<style>
    .projects {
        width: 100%;
        min-height: 100vh;
        display: flex;
        justify-content: flex-start;
        align-items: center;
        background-color: #171c27;
        color: white;
        position: relative;
        overflow: hidden;
        border-bottom: 2px solid #0077be;
    }
    .projects-container {
        width: 100%;
        height: 100%;
        padding: 5rem 15vw;
        text-align: left;
        z-index: 10;
    }
    .projects-header {
        margin-bottom: 3rem;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }
    .projects-title {
        font-size: 2.5rem;
        color: white;
        margin-bottom: 0.5rem;
    }
    .projects-subline {
        width: 50px;
        height: 3px;
        background-color: #78a200;
    }
    .big-light {
        position: absolute;
        top: 50%;
        right: -10%;
        transform: translate(0, -50%);
        width: 600px;
        height: 600px;
        border-radius: 50%;
        background: linear-gradient(45deg, #005999, #0077be);
        opacity: 0.2;
        filter: blur(150px);
        z-index: 0;
        animation: pulse 8s infinite alternate;
    }
    @keyframes pulse {
        0% { transform: scale(1) translate(0, -50%); }
        100% { transform: scale(1.1) translate(5%, -50%); }
    }

    @media (max-width: 768px) {
        .projects-container {
            padding: 5rem 5vw;
        }
    }
</style>
